<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pu</AssemblyName>
    <RootNamespace>Pu.App</RootNamespace>
    <!-- WPF 字体排版需要完整 CultureInfo；invariant 模式会在首次显示窗口时崩溃。 -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- WPF 桌面模式：不弹控制台（命令模式会临时分配） -->
    <OutputType>WinExe</OutputType>
    <!-- 应用本身就是 Windows 专用（右键菜单/托盘/注册表），避免 CA1416 平台噪音 -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
    <Version>0.0.520</Version>
    <StripSymbols>true</StripSymbols>
    <!-- 托盘与右键菜单图标：嵌入 exe（右键菜单 Icon= 值指向 exe,0） -->
    <ApplicationIcon>..\..\assets\pu.ico</ApplicationIcon>
    <!-- WPF 不支持 NativeAOT；使用自包含单文件发布，目标机器无需预装 .NET。 -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pu.Core\Pu.Core.csproj" />
    <EmbeddedResource Include="..\..\assets\pu.ico" LogicalName="pu.ico" />
    <Resource Include="..\..\assets\pu.ico" Link="Assets\pu.ico" />
    <Resource Include="..\..\assets\pu-logo.png" Link="Assets\pu-logo.png" />
  </ItemGroup>

</Project>
