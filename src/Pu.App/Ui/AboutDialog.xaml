<Window x:Class="Pu.App.Ui.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="关于 噗~噗噗~~噗噗噗噗~~~~"
        Icon="/pu;component/Assets/pu.ico"
        Width="380"
        Height="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F5F7FB"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        Foreground="#1E2735"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F4FB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EE" />
        <SolidColorBrush x:Key="TextBrush" Color="#1E2735" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66738A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F5BB5" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A6BC9" />
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#E9EFFA" />
        <SolidColorBrush x:Key="SoftAccentBorderBrush" Color="#CDDBF2" />
    </Window.Resources>

    <Border Background="#F5F7FB"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="关于 噗~噗噗~~噗噗噗噗~~~~" />
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="34" Height="34"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Path Width="10" Height="10"
                          Stroke="#66738A"
                          StrokeThickness="1.5"
                          Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="30,6,30,0">
                <Image Width="92" Height="92"
                       HorizontalAlignment="Center"
                       Source="/pu;component/Assets/pu-logo.png"
                       Stretch="Uniform" />
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Text="噗~噗噗~~噗噗噗噗~~~~" />
                <TextBlock x:Name="VersionText"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="12"
                           Text="v0.0.0" />
                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12.5"
                           LineHeight="19"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Text="电脑上右键一个视频，手机扫个码就能看。&#10;不用装 App · 不用拷文件 · 不用开会员" />

                <Button x:Name="GitHubButton"
                        Margin="0,18,0,0"
                        Height="40"
                        Padding="16,0"
                        HorizontalAlignment="Center"
                        Background="{StaticResource SoftAccentBrush}"
                        BorderBrush="{StaticResource SoftAccentBorderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource AccentBrush}"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="GitHubButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15"
                              Stretch="Uniform"
                              Fill="{StaticResource AccentBrush}"
                              Data="M 7.5 0 C 3.36 0 0 3.36 0 7.5 C 0 10.82 2.15 13.65 5.14 14.61 C 5.52 14.68 5.63 14.45 5.63 14.25 C 5.63 14.08 5.63 13.7 5.63 13.2 C 3.55 13.62 3.11 12.19 3.11 12.19 C 2.78 11.33 2.3 11.11 2.3 11.11 C 1.63 10.68 2.35 10.69 2.35 10.69 C 3.09 10.74 3.48 11.45 3.48 11.45 C 4.1 12.57 5.13 12.27 5.64 12.11 C 5.71 11.64 5.89 11.31 6.09 11.12 C 4.44 10.94 2.72 10.28 2.72 7.32 C 2.72 6.48 3.01 5.79 3.49 5.25 C 3.41 5.07 3.15 4.29 3.57 3.23 C 3.57 3.23 4.21 3.04 5.62 4.03 C 6.23 3.87 6.88 3.79 7.53 3.79 C 8.18 3.79 8.83 3.87 9.44 4.03 C 10.85 3.04 11.49 3.23 11.49 3.23 C 11.91 4.29 11.65 5.07 11.57 5.25 C 12.05 5.79 12.34 6.48 12.34 7.32 C 12.34 10.29 10.61 10.94 8.95 11.12 C 9.2 11.35 9.42 11.81 9.42 12.52 C 9.42 13.53 9.41 14.34 9.41 14.61 C 9.41 14.81 9.52 15.04 9.9 14.97 C 12.87 14.04 15 11.2 15 7.5 C 15 3.36 11.64 0 7.5 0 Z" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="GitHub · 提 issue / 下载最新版" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 底部：致谢 -->
            <Border Grid.Row="2"
                    Margin="0,0,0,0"
                    Padding="16,0"
                    Background="{StaticResource SoftAccentBrush}"
                    BorderBrush="{StaticResource SoftAccentBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,16,16">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#43577B"
                           FontSize="11.5"
                           TextAlignment="Center"
                           LineHeight="18"
                           Text="写给全世界最可爱的噗噗大王~&#10;🍓 ✨ 💎 🌸 🍬 ⚡ 📖 👑" />
            </Border>
        </Grid>
    </Border>
</Window>
