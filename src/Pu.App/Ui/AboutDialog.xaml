<Window x:Class="Pu.App.Ui.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Pu.App.Ui"
        Title="关于 噗~噗噗~~噗噗噗噗~~~~"
        Icon="/pu;component/Assets/pu.ico"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- 配色与控件样式来自 Application 资源（ThemeManager），和主窗口一起跟随深浅色 -->
    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <StackPanel>
            <!-- 标题栏 -->
            <Grid Height="44" Margin="18,0,6,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text2Brush}" Text="关于" />
                <Button HorizontalAlignment="Right" Style="{StaticResource TitleButton}" ToolTip="关闭"
                        AutomationProperties.Name="关闭" Click="CloseButton_Click">
                    <Path Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                </Button>
            </Grid>

            <StackPanel Margin="28,4,28,22">
                <ui:Mascot Width="96" Height="96" HorizontalAlignment="Left" Face="Ready" />
                <TextBlock Margin="0,14,0,0" FontFamily="{DynamicResource DisplayFont}" FontSize="20" FontWeight="Bold"
                           Text="噗~噗噗~~噗噗噗噗~~~~" />
                <TextBlock x:Name="VersionText" Margin="0,2,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                           Foreground="{DynamicResource Text3Brush}" Text="v0.0.0" />
                <TextBlock Margin="0,14,0,0" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource Text2Brush}"
                           Text="电脑上右键一个视频，手机扫个码就能看。不用装 App，不用拷文件，不用开会员。" />
                <Button x:Name="GitHubButton" Margin="0,16,0,0" HorizontalAlignment="Left" Style="{StaticResource PuButton}"
                        Click="GitHubButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource TextBrush}"
                              Data="M 7.5 0 C 3.36 0 0 3.36 0 7.5 C 0 10.82 2.15 13.65 5.14 14.61 C 5.52 14.68 5.63 14.45 5.63 14.25 C 5.63 14.08 5.63 13.7 5.63 13.2 C 3.55 13.62 3.11 12.19 3.11 12.19 C 2.78 11.33 2.3 11.11 2.3 11.11 C 1.63 10.68 2.35 10.69 2.35 10.69 C 3.09 10.74 3.48 11.45 3.48 11.45 C 4.1 12.57 5.13 12.27 5.64 12.11 C 5.71 11.64 5.89 11.31 6.09 11.12 C 4.44 10.94 2.72 10.28 2.72 7.32 C 2.72 6.48 3.01 5.79 3.49 5.25 C 3.41 5.07 3.15 4.29 3.57 3.23 C 3.57 3.23 4.21 3.04 5.62 4.03 C 6.23 3.87 6.88 3.79 7.53 3.79 C 8.18 3.79 8.83 3.87 9.44 4.03 C 10.85 3.04 11.49 3.23 11.49 3.23 C 11.91 4.29 11.65 5.07 11.57 5.25 C 12.05 5.79 12.34 6.48 12.34 7.32 C 12.34 10.29 10.61 10.94 8.95 11.12 C 9.2 11.35 9.42 11.81 9.42 12.52 C 9.42 13.53 9.41 14.34 9.41 14.61 C 9.41 14.81 9.52 15.04 9.9 14.97 C 12.87 14.04 15 11.2 15 7.5 C 15 3.36 11.64 0 7.5 0 Z" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Text="在 GitHub 提问题、下载新版" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 底部：致谢 -->
            <Border Padding="16,12" Background="{DynamicResource InkSoftBrush}" CornerRadius="0,0,14,14">
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" LineHeight="19"
                           Foreground="{DynamicResource Text2Brush}"
                           Text="写给全世界最可爱的噗噗大王~&#10;🍓 ✨ 💎 🌸 🍬 ⚡ 📖 👑" />
            </Border>
        </StackPanel>
    </Border>
</Window>
