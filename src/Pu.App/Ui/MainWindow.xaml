<Window x:Class="Pu.App.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="pu~"
        Icon="/pu;component/Assets/pu.ico"
        Width="480"
        Height="650"
        MinWidth="480"
        MinHeight="650"
        MaxWidth="480"
        MaxHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Background="#F5F7FB"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        Foreground="#1E2735"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F5F7FB" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F4FB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE3EE" />
        <SolidColorBrush x:Key="LineStrongBrush" Color="#C2CEDE" />
        <SolidColorBrush x:Key="TextBrush" Color="#1E2735" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66738A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F5BB5" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A6BC9" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#27499A" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#1D3F86" />
        <SolidColorBrush x:Key="SoftAccentBrush" Color="#E9EFFA" />
        <SolidColorBrush x:Key="SoftAccentBorderBrush" Color="#CDDBF2" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E9463" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C02F47" />

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                <Setter TargetName="Chrome" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98" /></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="#33415C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="#552F5BB5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBar"
                  Grid.Row="0"
                  Margin="8,6,8,0"
                  Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Width="44" Height="44"
                           Source="/pu;component/Assets/pu-logo.png"
                           Stretch="Uniform" />
                    <TextBlock Margin="11,0,0,1"
                               VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="pu~" />
                    <Border Margin="14,0,0,0"
                            Padding="10,5"
                            Background="{StaticResource SoftAccentBrush}"
                            BorderBrush="{StaticResource SoftAccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="WindowStatusDot"
                                     Width="6" Height="6"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="WindowStatusText"
                                       Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#43577B"
                                       FontSize="11.5"
                                       FontWeight="Medium"
                                       Text="等待任务" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource TitleButton}"
                            ToolTip="最小化"
                            AutomationProperties.Name="最小化"
                            Click="MinimizeButton_Click">
                        <Path Width="12" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M 0,0 L 12,0 L 12,1 L 0,1 Z" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource TitleButton}"
                            ToolTip="停止并退出"
                            AutomationProperties.Name="停止并退出"
                            Click="CloseButton_Click">
                        <Path Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="30,8,30,28">
                <Grid x:Name="IdleView">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-20,0,0">
                        <Image Width="128" Height="128"
                               HorizontalAlignment="Center"
                               Source="/pu;component/Assets/pu-logo.png"
                               Stretch="Uniform" />
                        <TextBlock Margin="0,20,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="把视频递到手机上" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Text="对面不用装任何 App，浏览器打开即播" />

                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Padding="4,9"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="1" />
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="右键视频" />
                                </StackPanel>
                            </Border>
                            <Path Grid.Column="1"
                                  Width="10" Height="10"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 L 8,5 L 1,9"
                                  Stroke="{StaticResource LineStrongBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Fill" />
                            <Border Grid.Column="2"
                                    Padding="4,9"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="2" />
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="选择 pu~" />
                                </StackPanel>
                            </Border>
                            <Path Grid.Column="3"
                                  Width="10" Height="10"
                                  VerticalAlignment="Center"
                                  Data="M 1,1 L 8,5 L 1,9"
                                  Stroke="{StaticResource LineStrongBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Fill" />
                            <Border Grid.Column="4"
                                    Padding="4,9"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="3" />
                                    <TextBlock Margin="0,3,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="手机扫码看" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="JobView" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="JobTitleText"
                                       FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="JobDescriptionText"
                                       Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="BackToFolderButton"
                                Grid.Column="1"
                                Height="34"
                                Padding="12,0"
                                Margin="12,0,0,0"
                                Style="{StaticResource BaseButton}"
                                FontSize="12"
                                Content="返回列表"
                                Visibility="Collapsed"
                                Click="BackToFolderButton_Click" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <Grid Width="226" Height="226">
                            <Border CornerRadius="18"
                                    Background="White"
                                    BorderBrush="#E0E7F3"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.13" Color="#46608F" />
                                </Border.Effect>
                                <Image x:Name="JobQrImage" Margin="13" Stretch="Uniform" />
                            </Border>
                            <Path Width="22" Height="22" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1.5,22 L 1.5,10 Q 1.5,1.5 10,1.5 L 22,1.5" />
                            <Path Width="22" Height="22" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 0,1.5 L 12,1.5 Q 20.5,1.5 20.5,10 L 20.5,22" />
                            <Path Width="22" Height="22" Margin="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 22,20.5 L 10,20.5 Q 1.5,20.5 1.5,12 L 1.5,0" />
                            <Path Width="22" Height="22" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 20.5,0 L 20.5,12 Q 20.5,20.5 12,20.5 L 0,20.5" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12.5"
                                   Text="手机或平板扫一扫 · 同一 Wi-Fi" />
                    </StackPanel>

                    <TextBox x:Name="JobLinkTextBox"
                             Grid.Row="2"
                             Margin="0,14,0,0"
                             Style="{StaticResource LinkTextBox}"
                             ToolTip="播放链接" />

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="138" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="JobCopyButton"
                                Style="{StaticResource BaseButton}"
                                Content="复制链接"
                                Click="CopyButton_Click" />
                        <Button x:Name="JobOpenButton"
                                Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Content="打开播放页"
                                Click="OpenButton_Click" />
                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,14,0,0"
                            Padding="16,14"
                            VerticalAlignment="Top"
                            Background="{StaticResource SoftAccentBrush}"
                            BorderBrush="{StaticResource SoftAccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="JobStateDot"
                                     Width="8" Height="8"
                                     Margin="0,5,12,0"
                                     VerticalAlignment="Top"
                                     Fill="{StaticResource AccentBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="JobStateTitleText" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="JobStateDetailText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="JobProgressBar"
                                             Margin="0,10,0,0"
                                             Style="{StaticResource SlimProgress}"
                                             Minimum="0" Maximum="100"
                                             Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="JobProgressText"
                                       Grid.Column="2"
                                       Margin="16,0,0,0"
                                       Foreground="{StaticResource AccentDeepBrush}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="BusyView" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-24,0,0">
                        <Image Width="104" Height="104"
                               HorizontalAlignment="Center"
                               Source="/pu;component/Assets/pu-logo.png"
                               Stretch="Uniform" />
                        <TextBlock x:Name="BusyTitleText"
                                   Margin="0,22,0,0"
                                   HorizontalAlignment="Center"
                                   MaxWidth="380"
                                   FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Ellipse Width="7" Height="7"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.25" Duration="0:0:0.9" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="BusyHintText"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="13"
                                       Text="正在分析…" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid x:Name="FolderView" Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="FolderTitleText"
                                       FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                                       FontSize="23"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12.5"
                                       Text="点一个文件，马上发到手机" />
                        </StackPanel>
                        <TextBlock x:Name="FolderCountText"
                                   Grid.Column="1"
                                   Margin="12,3,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="116" Height="116">
                            <Border CornerRadius="14"
                                    Background="White"
                                    BorderBrush="#E0E7F3"
                                    BorderThickness="1">
                                <Image x:Name="FolderQrImage" Margin="8" Stretch="Uniform" />
                            </Border>
                            <Path Width="14" Height="14" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1.5,14 L 1.5,8 Q 1.5,1.5 8,1.5 L 14,1.5" />
                            <Path Width="14" Height="14" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 0,1.5 L 6,1.5 Q 12.5,1.5 12.5,8 L 12.5,14" />
                            <Path Width="14" Height="14" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 14,12.5 L 8,12.5 Q 1.5,12.5 1.5,6 L 1.5,0" />
                            <Path Width="14" Height="14" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Stretch="Fill" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 12.5,0 L 12.5,6 Q 12.5,12.5 6,12.5 L 0,12.5" />
                        </Grid>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBox x:Name="FolderLinkTextBox"
                                     Style="{StaticResource LinkTextBox}"
                                     ToolTip="文件夹链接" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FolderCopyButton"
                                        Height="42"
                                        Padding="8,0"
                                        Style="{StaticResource BaseButton}"
                                        FontSize="12.5"
                                        Content="复制"
                                        Click="CopyButton_Click" />
                                <Button x:Name="FolderOpenButton"
                                        Grid.Column="2"
                                        Height="42"
                                        Padding="8,0"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="12.5"
                                        Content="打开"
                                        Click="OpenButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,21,0,10">
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="媒体文件" />
                        <TextBlock x:Name="FolderFeedbackText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" />
                    </Grid>

                    <ListBox x:Name="FolderList"
                             Grid.Row="3"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,7" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Height="54"
                                        Padding="14,0"
                                        HorizontalContentAlignment="Stretch"
                                        Style="{StaticResource BaseButton}"
                                        Tag="{Binding Index}"
                                        IsEnabled="{Binding IsEnabled}"
                                        Click="FolderItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11"
                                                   Text="{Binding DisplayIndex}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Foreground="{StaticResource TextBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10.5"
                                                       Text="{Binding SizeText}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding StateBrush}"
                                                   FontSize="11.5"
                                                   Text="{Binding StateText}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
