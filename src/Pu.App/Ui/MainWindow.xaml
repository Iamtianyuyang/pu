<Window x:Class="Pu.App.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Pu.App.Ui"
        Title="噗~噗噗~~噗噗噗噗~~~~"
        Icon="/pu;component/Assets/pu.ico"
        Width="440"
        MinWidth="440"
        MaxWidth="440"
        MinHeight="300"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        ShowInTaskbar="True"
        Background="{DynamicResource PaperBrush}"
        FontFamily="{DynamicResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- 窗口：宽度固定 440，高度随内容（单文件是一张紧凑卡片）；文件夹模式改为可上下拉伸并记住高度（见 MainWindow.cs） -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="27" />
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}" />
        </Style>

        <!-- 二维码卡片：白底（深色模式也保持白底黑码，扫码器才认得）+ 墨水蓝四角 -->
        <ControlTemplate x:Key="QrFrame" TargetType="ContentControl">
            <Grid>
                <Border CornerRadius="16" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1.5" Padding="10">
                    <ContentPresenter />
                </Border>
                <Path Width="20" Height="20" Margin="-3" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"
                      Stroke="{DynamicResource InkBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 1.5,20 L 1.5,9 Q 1.5,1.5 9,1.5 L 20,1.5" />
                <Path Width="20" Height="20" Margin="-3" HorizontalAlignment="Right" VerticalAlignment="Top" Stretch="Fill"
                      Stroke="{DynamicResource InkBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 0,1.5 L 11,1.5 Q 18.5,1.5 18.5,9 L 18.5,20" />
                <Path Width="20" Height="20" Margin="-3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Fill"
                      Stroke="{DynamicResource InkBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 20,18.5 L 9,18.5 Q 1.5,18.5 1.5,11 L 1.5,0" />
                <Path Width="20" Height="20" Margin="-3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stretch="Fill"
                      Stroke="{DynamicResource InkBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 18.5,0 L 18.5,11 Q 18.5,18.5 11,18.5 L 0,18.5" />
            </Grid>
        </ControlTemplate>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：小噗噗 + 品牌名，拖动窗口 -->
            <Grid x:Name="TitleBar" Grid.Row="0" Margin="14,4,6,0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Mascot Width="24" Height="24" Face="Ready" Animate="False" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text2Brush}" Text="噗~噗噗~~噗噗噗噗~~~~" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}" ToolTip="最小化"
                            AutomationProperties.Name="最小化" Click="MinimizeButton_Click">
                        <Path Width="12" Height="1.5" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 0,0 L 12,0 L 12,1.5 L 0,1.5 Z" />
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" ToolTip="停止并退出"
                            AutomationProperties.Name="停止并退出" Click="CloseButton_Click">
                        <Path Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1,1 L 10,10 M 10,1 L 1,10" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="24,2,24,22">

                <!-- ── 空闲：还没有任务 ── -->
                <StackPanel x:Name="IdleView" Visibility="Collapsed">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Mascot x:Name="IdleMascot" Width="108" Height="108" Face="Idle" />
                        <ui:SpeechBubble x:Name="IdleBubble" />
                    </StackPanel>
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource H1}" Text="把视频递到手机上" />
                    <!-- 品牌名单独成行：它全是 ~，夹在句子里会被折成两半 -->
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Body}">
                        <Run Text="在电脑上右键一个视频或文件夹，选菜单里的" /><LineBreak />
                        <Run Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" Text="「噗~噗噗~~噗噗噗噗~~~~」" /><Run Text="，" /><LineBreak />
                        <Run Text="再用手机扫窗口里的二维码。" />
                    </TextBlock>
                    <TextBlock Margin="0,8,0,4" Style="{StaticResource Note}"
                               Text="对面不用装 App，同一个 Wi-Fi 下用浏览器打开就能看。" />
                </StackPanel>

                <!-- ── 正在分析（探测 / 扫描） ── -->
                <StackPanel x:Name="BusyView" Visibility="Collapsed">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Mascot x:Name="BusyMascot" Width="96" Height="96" Face="Busy" />
                        <ui:SpeechBubble x:Name="BusyBubble" />
                    </StackPanel>
                    <TextBlock x:Name="BusyTitleText" Margin="0,18,0,0" Style="{StaticResource H1}" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="BusyHintText" Margin="0,6,0,6" Style="{StaticResource Body}" Text="正在分析视频…" />
                </StackPanel>

                <!-- ── 出错（探测 / 扫描 / 启动失败） ── -->
                <StackPanel x:Name="ErrorView" Visibility="Collapsed">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <ui:Mascot x:Name="ErrorMascot" Width="96" Height="96" Margin="0,10,0,0" HorizontalAlignment="Left" Face="Error" />
                    <TextBlock Margin="0,18,0,0" Style="{StaticResource H1}" Text="没能处理这个文件" />
                    <TextBlock x:Name="ErrorTitleText" Margin="0,4,0,0" Style="{StaticResource Body}" MaxHeight="42" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ErrorMessageText" Margin="0,10,0,0" Style="{StaticResource Body}" Foreground="{DynamicResource BadBrush}" />
                    <TextBlock Margin="0,12,0,6" Style="{StaticResource Body}" Foreground="{DynamicResource TextBrush}"
                               Text="换一个文件，或者重新右键它再试一次。" />
                </StackPanel>

                <!-- ── 单个视频：二维码 → 送达；转码进度在下面 ── -->
                <StackPanel x:Name="JobView" Visibility="Collapsed">
                    <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                    <Grid Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Mascot x:Name="JobMascot" Width="72" Height="72" Face="Busy" />
                            <ui:SpeechBubble x:Name="JobBubble" />
                        </StackPanel>
                        <Button x:Name="BackToFolderButton" Style="{StaticResource PuQuietButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Visibility="Collapsed" Click="BackToFolderButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="7" Height="11" Margin="0,0,6,0" Stretch="Fill" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 6,1 L 1,5.5 L 6,10" />
                                <TextBlock Text="返回列表" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="JobTitleText" Margin="0,14,0,0" Style="{StaticResource H1}" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="JobDescriptionText" Margin="0,4,0,0" Style="{StaticResource Note}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                    <!-- 送达：手机打开过之后 -->
                    <Border x:Name="JobDelivered" Margin="0,16,0,0" Padding="16,13" CornerRadius="14"
                            Background="{DynamicResource InkSoftBrush}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock FontSize="17" FontWeight="Bold">
                                <Run Text="已送到 " /><Run x:Name="JobDeliveredDevice" Background="{DynamicResource MarkerBrush}" Foreground="#17213A" />
                            </TextBlock>
                            <TextBlock x:Name="JobDeliveredHint" Margin="0,4,0,0" Style="{StaticResource Body}" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="JobQrPanel" Margin="0,18,0,0">
                        <ContentControl Width="196" Height="196" HorizontalAlignment="Center" Template="{StaticResource QrFrame}">
                            <Image x:Name="JobQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </ContentControl>
                        <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource Body}" Text="手机扫一扫，同一个 Wi-Fi 下打开" />
                    </StackPanel>
                    <Button x:Name="JobShowQrButton" Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource PuQuietButton}"
                            Visibility="Collapsed" Click="ShowQrButton_Click" Content="再给一台设备扫码" />

                    <StackPanel x:Name="JobSharePanel">
                    <TextBox x:Name="JobLinkTextBox" Margin="0,14,0,0" Style="{StaticResource LinkBox}"
                             AutomationProperties.Name="播放链接" GotKeyboardFocus="LinkBox_GotKeyboardFocus" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="JobCopyButton" Style="{StaticResource PuButton}" Content="复制链接" Click="CopyButton_Click" />
                        <Button x:Name="JobOpenButton" Grid.Column="2" Style="{StaticResource PuInkButton}" Content="在这台电脑上打开" Click="OpenButton_Click" />
                    </Grid>
                    </StackPanel>

                    <!-- 状态：转码中 = 百分比 + 排线进度；可播 / 失败 = 一句话 -->
                    <StackPanel x:Name="JobProgressPanel" Margin="0,20,0,0">
                        <Grid>
                            <TextBlock VerticalAlignment="Bottom">
                                <Run x:Name="JobPercentText" FontSize="30" FontWeight="Heavy" Foreground="{DynamicResource InkBrush}" Text="0" /><Run FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Text="%" />
                            </TextBlock>
                            <TextBlock x:Name="JobEtaText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}" />
                        </Grid>
                        <ui:HatchProgress x:Name="JobHatch" Margin="0,8,0,0" Ink="{DynamicResource InkBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="JobStateText" Margin="0,10,0,0" Style="{StaticResource Body}" />
                </StackPanel>

                <!-- ── 文件夹：整个列表一个二维码；也可以在这里点开单集 ── -->
                <Grid x:Name="FolderView" Visibility="Collapsed">
                    <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Mascot x:Name="FolderMascot" Width="64" Height="64" Face="Idle" />
                        <ui:SpeechBubble x:Name="FolderBubble" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock x:Name="FolderTitleText" Style="{StaticResource H1}" MaxHeight="54" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FolderCountText" Margin="0,2,0,0" Style="{StaticResource Note}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <Border x:Name="FolderDelivered" Padding="16,12" CornerRadius="14" Background="{DynamicResource InkSoftBrush}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontSize="16" FontWeight="Bold">
                                    <Run Text="已送到 " /><Run x:Name="FolderDeliveredDevice" Background="{DynamicResource MarkerBrush}" Foreground="#17213A" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Body}" Text="那边可以从列表里挑着看了" />
                            </StackPanel>
                        </Border>
                        <Grid x:Name="FolderQrPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Width="124" Height="124" Template="{StaticResource QrFrame}">
                                <Image x:Name="FolderQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </ContentControl>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="手机扫一扫，整个文件夹都在里面" />
                                <TextBox x:Name="FolderLinkTextBox" Margin="0,10,0,0" Style="{StaticResource LinkBox}"
                                         AutomationProperties.Name="文件夹链接" GotKeyboardFocus="LinkBox_GotKeyboardFocus" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="FolderCopyButton" Height="38" Padding="6,0" FontSize="13" Style="{StaticResource PuButton}" Content="复制" Click="CopyButton_Click" />
                                    <Button x:Name="FolderOpenButton" Grid.Column="2" Height="38" Padding="6,0" FontSize="13" Style="{StaticResource PuInkButton}" Content="打开" Click="OpenButton_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <Button x:Name="FolderShowQrButton" Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource PuQuietButton}"
                                Visibility="Collapsed" Click="ShowQrButton_Click" Content="再给一台设备扫码" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,18,0,6">
                        <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="也可以在这里点开一个" />
                        <TextBlock x:Name="FolderFeedbackText" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Note}" TextWrapping="NoWrap" />
                    </Grid>

                    <Border Grid.Row="4" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1.5,0,0" MinHeight="120">
                        <ListBox x:Name="FolderList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,4,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 KeyboardNavigation.TabNavigation="Continue">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                            </ListBox.Resources>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                                    <ContentPresenter Margin="0,1" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RowButton}" Tag="{Binding Index}" IsEnabled="{Binding IsEnabled}"
                                            Click="FolderItem_Click" AutomationProperties.Name="{Binding Name}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text3Brush}" Text="{Binding DisplayIndex}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontSize="13.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource Text3Brush}" Text="{Binding SizeText}" />
                                            </StackPanel>
                                            <TextBlock x:Name="State" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{DynamicResource Text3Brush}" Text="{Binding StateText}" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Busy">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Ok">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource OkBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Bad">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource BadBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Opening">
                                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource InkBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
