<!-- 配色 token（浅色）：键名与网页 web/pu.css 的 CSS 变量一一对应，改色两边一起改 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PaperBrush" Color="#F9F9F6" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#DDE1EA" />
    <SolidColorBrush x:Key="RuleBrush" Color="#0B0B3F8F" />
    <SolidColorBrush x:Key="TextBrush" Color="#17213A" />
    <SolidColorBrush x:Key="Text2Brush" Color="#48526B" />
    <SolidColorBrush x:Key="Text3Brush" Color="#636C84" />
    <SolidColorBrush x:Key="InkBrush" Color="#0B3F8F" />
    <SolidColorBrush x:Key="OnInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#E7EDF8" />
    <SolidColorBrush x:Key="MarkerBrush" Color="#FFE27A" />
    <SolidColorBrush x:Key="OkBrush" Color="#23794A" />
    <SolidColorBrush x:Key="WarnBrush" Color="#8F5B00" />
    <SolidColorBrush x:Key="BadBrush" Color="#BF3A30" />
    <SolidColorBrush x:Key="MascotFillBrush" Color="#FFFFFF" />
    <!-- 悬停底色：卡片上叠一层淡墨水色 -->
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F4FA" />
    <Color x:Key="ShadowColor">#1B2A4A</Color>
</ResourceDictionary>
